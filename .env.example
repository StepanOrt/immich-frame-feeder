# Immich Configuration
IMMICH_URL=https://immich.example.com
IMMICH_ALBUM_ID=your-album-uuid-here
IMMICH_API_KEY=your-immich-api-key-here

# Library Mount Paths
IMMICH_LIBRARY_PATH=/mnt/pool/immich/library
FOTO_LIBRARY_PATH=/mnt/pool/foto

# Image Processing (Optional)
RESOLUTION=1920x1280
JPEG_QUALITY=99%

# Polling Interval (Optional, in seconds, minimum 10)
POLL_INTERVAL_SECONDS=60

# Safety Controls (Optional, defaults to false)
# ALLOW_EMPTY_ALBUM=false
# ALLOW_MASS_DELETE=false
